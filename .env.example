# Copy to .env (git-ignored) and fill in. NEVER commit real values.
WIZ_CLIENT_ID=your-client-id
WIZ_CLIENT_SECRET=your-client-secret
# Regional endpoint from Wiz portal -> Tenant Info, e.g. https://api.<region>.app.wiz.io/graphql
WIZ_API_URL=https://api.REGION.app.wiz.io/graphql
WIZ_AUTH_URL=https://auth.app.wiz.io/oauth/token
# wiz-api (Cognito, default) or beyond-api (legacy Auth0)
WIZ_AUDIENCE=wiz-api
